# Build-time API base (must include /api path prefix if routes live under /api)
# Local:
VITE_API_URL=http://localhost:5000/api
# Production (Cloudflare Pages build env):
# VITE_API_URL=https://jeevan-health-api.onrender.com/api

# Google Sign-In (must match API GOOGLE_CLIENT_ID; add JS origins for domain + localhost)
# VITE_GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
